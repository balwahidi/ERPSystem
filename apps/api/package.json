    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "bidi-js": "1.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
